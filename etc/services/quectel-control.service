[Unit]
Description=Quectel modem control server (ZMQ front end to the AT port)
Requires=dev-ttyUSB2.device
After=dev-ttyUSB2.device
After=network.target

[Service]
Environment=PYTHONUNBUFFERED=1
Type=simple
Restart=always
RestartSec=1
WorkingDirectory=/local/repository/bin
ExecStart=/local/repository/.venv/bin/python /local/repository/bin/quectel_control.py

[Install]
WantedBy=multi-user.target
