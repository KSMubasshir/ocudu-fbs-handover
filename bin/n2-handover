#!/bin/bash
STATS=/var/tmp/oai/cmake_targets/ran_build/build/nrRRC_stats.log
TELNET_ADDR=127.0.0.1
TELNET_PORT=9090
TARGET_PCI=$1
UE_ID=$2

usage() {
    cat <<EOF2
usage:
    n2-handover -h
        show this help message
    n2-handover <target pci> [<ue id>]
        force an N2 handover from the OAI gNB running on this node to the
        neighbour cell <target pci> (3 from gNB 1 on cudu, 1 from gNB 2 on
        cudu2), through the gNB's telnet server ("ci trigger_n2_ho").
        <ue id> is the "CU UE ID" in $STATS;
        it can be left out when the gNB has exactly one UE.
EOF2
}

if [ "$1" == "-h" ]; then
    usage; exit 0
fi

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    usage; exit 1
fi

if ! [[ $TARGET_PCI =~ ^[0-9]+$ ]]; then
    echo "invalid target pci"; usage; exit 1
fi

if [ -z "$UE_ID" ]; then
    UE_IDS=( $(sudo grep -o "CU UE ID [0-9]*" $STATS 2> /dev/null | awk '{print $4}') )
    if [ ${#UE_IDS[@]} -ne 1 ]; then
        echo "found ${#UE_IDS[@]} UEs in $STATS; give the ue id"; usage; exit 1
    fi
    UE_ID=${UE_IDS[0]}
fi

if ! [[ $UE_ID =~ ^[0-9]+$ ]]; then
    echo "invalid ue id"; usage; exit 1
fi

echo "triggering N2 handover of UE $UE_ID to PCI $TARGET_PCI..."
echo ci trigger_n2_ho $TARGET_PCI,$UE_ID | nc -w 2 $TELNET_ADDR $TELNET_PORT && echo
