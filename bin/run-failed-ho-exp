#!/bin/bash
# Failed-handover experiment from your own machine. gNB 1 (cn5g, home 999/99)
# carries a phantom neighbour (etc/oai/neighbour-config-phantom.conf) that
# advertises gNB 2's carrier/PCI under a fake target identity core 1 cannot
# resolve. gNB 2 (cn5g2, foreign 001/01) is a real but unrelated network.
#
# Restart both gNBs, attach ue1 to gNB 1, bring gNB 2 up on its own carrier,
# then force gNB 1 to start a handover toward the phantom target (standing in
# for the UE's request: the Quectel does not spontaneously report a neighbour
# on this testbed). Capture core 1's NGAP, the AMF log, gNB 1's log and the UE
# serving cell, and show the HandoverRequired being rejected and the UE
# staying on gNB 1.
REPO=$(cd "$(dirname "$0")/.." && pwd)
HOSTS_FILE=$REPO/hosts.env
REMOTE_BIN=/local/repository/bin
OAI_BUILD=/var/tmp/oai/cmake_targets/ran_build/build
TARGET_PCI=3
OUTDIR=""

usage() {
    cat <<EOF
usage:
    run-failed-ho-exp -h
        show this help message
    run-failed-ho-exp [-o <dir>] [-f <hosts file>]
        -o  local output directory (default traces/failed-ho-<date>-<time>)
        -f  hosts file setting SSH_USER, CN5G, CN5G2, CUDU, CUDU2, UE1
            (default hosts.env in the repo)

    OAI must already be built on cudu and cudu2, and Open5GS installed on
    cn5g and cn5g2.
EOF
}

while getopts "ho:f:" opt; do
    case $opt in
        h) usage; exit 0 ;;
        o) OUTDIR=$OPTARG ;;
        f) HOSTS_FILE=$OPTARG ;;
        *) usage; exit 1 ;;
    esac
done

[ -f "$HOSTS_FILE" ] || { echo "$HOSTS_FILE not found"; usage; exit 1; }
source "$HOSTS_FILE"
for var in SSH_USER CN5G CN5G2 CUDU CUDU2 UE1; do
    [ -n "${!var}" ] || { echo "$var is not set in $HOSTS_FILE"; exit 1; }
done

OUTDIR=${OUTDIR:-$REPO/traces/failed-ho-$(date +%Y-%m-%d-%H%M%S)}
mkdir -p "$OUTDIR" || { echo "cannot create $OUTDIR"; exit 1; }
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=15"

on() { ssh $SSH_OPTS $SSH_USER@$1 'bash -s'; }
step() { echo; echo "== $*"; }
die() { echo "ERROR: $*" >&2; exit 1; }

push() {
    local host=$1; shift
    ssh $SSH_OPTS $SSH_USER@$host 'mkdir -p /tmp/ho-bin' || return 1
    scp -q $SSH_OPTS "$@" $SSH_USER@$host:/tmp/ho-bin/ || return 1
    ssh $SSH_OPTS $SSH_USER@$host "sudo install -m 775 /tmp/ho-bin/* $REMOTE_BIN/"
}
push_cfg() {
    local host=$1; shift
    ssh $SSH_OPTS $SSH_USER@$host 'mkdir -p /tmp/ho-cfg' || return 1
    scp -q $SSH_OPTS "$@" $SSH_USER@$host:/tmp/ho-cfg/ || return 1
    ssh $SSH_OPTS $SSH_USER@$host "sudo mkdir -p /var/tmp/etc/oai && sudo install -m 644 /tmp/ho-cfg/* /var/tmp/etc/oai/"
}

start_gnb() {
    on $1 <<EOF
set -e
[ -f /var/tmp/oai-setup-complete ] || { echo "\$(hostname -s): OAI is not built"; exit 1; }
sudo pkill -INT -x nr-softmodem || true
for i in \$(seq 30); do pgrep -x nr-softmodem > /dev/null || break; sleep 1; done
sudo pkill -KILL -x nr-softmodem || true
tmux kill-session -t gnb 2> /dev/null || true
sudo rm -f /tmp/gnb.log $OAI_BUILD/nrRRC_stats.log
tmux new-session -d -s gnb -x 200 -y 50 $REMOTE_BIN/start-oai-gnb
EOF
}
wait_gnb() {
    on $1 <<'EOF'
for i in $(seq 120); do
    if grep -aq "Received NGSetupResponse" /tmp/gnb.log 2> /dev/null && grep -aq "RF started" /tmp/gnb.log; then
        echo "$(hostname -s): gNB started"; exit 0
    fi
    pgrep -x nr-softmodem > /dev/null || [ $i -lt 5 ] || break
    sleep 2
done
echo "$(hostname -s): gNB did not start:"; tail -n 15 /tmp/gnb.log; exit 1
EOF
}

step "Checking the nodes and installing scripts/configs"
for host in $CN5G $CN5G2 $CUDU $CUDU2 $UE1; do
    ssh $SSH_OPTS $SSH_USER@$host true || die "cannot reach $host; update $HOSTS_FILE"
done
push $CN5G "$REPO/bin/ngap-capture" || die "copy to $CN5G failed"
for host in $CUDU $CUDU2; do
    push $host "$REPO/bin/start-oai-gnb" || die "copy to $host failed"
done
push_cfg $CUDU "$REPO/etc/oai/gnb1_x310_core1.conf" "$REPO/etc/oai/neighbour-config-phantom.conf" || die "config copy to $CUDU failed"
push_cfg $CUDU2 "$REPO/etc/oai/gnb2_n300_core2.conf" || die "config copy to $CUDU2 failed"

step "Starting gNB 1 (-> core 1) on cudu and gNB 2 (-> core 2) on cudu2"
start_gnb $CUDU & p1=$!
start_gnb $CUDU2 & p2=$!
wait $p1 || die "could not start gNB 1"
wait $p2 || die "could not start gNB 2"
wait_gnb $CUDU || die "gNB 1 is not running"
wait_gnb $CUDU2 || die "gNB 2 is not running"
on $CUDU <<'EOF'
grep -a "Neighbour\[0\]" /tmp/gnb.log | head -1
EOF

step "Attaching ue1 to gNB 1 (gNB 1 only reaches ue1 at first)"
on $CUDU <<EOF || die "could not set attenuators"
$REMOTE_BIN/update-attens ru1ue1 0
$REMOTE_BIN/update-attens gnb2ue1 95
EOF
on $UE1 <<EOF || die "ue1 did not get a data connection"
pgrep -x quectel-CM > /dev/null || { tmux kill-session -t cm 2> /dev/null; tmux new-session -d -s cm 'sudo quectel-CM -s internet -4'; }
$REMOTE_BIN/module-airplane.sh > /dev/null 2>&1
sleep 3
$REMOTE_BIN/module-on.sh > /dev/null 2>&1
for i in \$(seq 45); do
    ping -c 1 -W 1 10.45.0.1 > /dev/null 2>&1 && { echo "ue1 reaches 10.45.0.1"; exit 0; }
    sleep 2
done
exit 1
EOF
on $UE1 <<'EOF' || die "could not start the ping"
tmux kill-session -t ping 2> /dev/null; rm -f /tmp/ping-ho.out
tmux new-session -d -s ping "bash -c 'ping -D -O -i 0.2 10.45.0.1 > /tmp/ping-ho.out 2>&1'"
EOF

step "Bringing gNB 2 up on its own carrier (candidate on air)"
on $CUDU <<EOF || die "could not set attenuators"
$REMOTE_BIN/update-attens gnb2ue1 0
EOF
sleep 5

step "Capturing core 1 NGAP and forcing the handover toward the phantom target"
on $CN5G <<EOF || die "could not start the NGAP capture"
tmux kill-session -t ngap 2> /dev/null
sudo pkill -INT -x tcpdump
sudo rm -f /tmp/ngap.pcap
tmux new-session -d -s ngap '$REMOTE_BIN/ngap-capture /tmp/ngap.pcap'
sleep 2
pgrep -x tcpdump > /dev/null
EOF
START=$(on $CN5G <<< 'date +%s')
UE=$(on $CUDU <<< "sudo grep -oE 'CU UE ID [0-9]+' $OAI_BUILD/nrRRC_stats.log | grep -oE '[0-9]+' | tail -1")
[ -n "$UE" ] || die "no UE on gNB 1"
echo "UE id on gNB 1 = $UE; triggering ci trigger_n2_ho $TARGET_PCI,$UE"
on $CUDU <<EOF
echo ci trigger_n2_ho $TARGET_PCI,$UE | nc -w 2 127.0.0.1 9090
EOF
sleep 6

step "Stopping capture and collecting results in $OUTDIR"
on $CN5G <<EOF
tmux send-keys -t ngap C-c
sleep 1
sudo pkill -INT -x tcpdump
sudo journalctl -u open5gs-amfd --since @$START --no-pager -o short-precise 2> /dev/null | sed 's/\x1b\[[0-9;]*m//g' > /tmp/amf.log
sudo tshark -r /tmp/ngap.pcap -Y ngap 2> /dev/null > /tmp/ngap.txt
true
EOF
on $UE1 <<'EOF'
tmux send-keys -t ping C-c; sleep 1; tmux kill-session -t ping 2> /dev/null
sudo sh -c 'chat -t 5 -sv "" AT OK "AT+QENG=\"servingcell\"" OK < /dev/ttyUSB2 > /dev/ttyUSB2' 2>&1 | grep -a "^+QENG" | tr -d '\r' > /tmp/ue-cell.txt
cat /tmp/ue-cell.txt
EOF
fetch() { scp -q -C $SSH_OPTS $SSH_USER@$1:$2 "$OUTDIR/$3" || echo "could not fetch $2 from $1"; }
fetch $CN5G /tmp/ngap.pcap core1-ngap.pcap
fetch $CN5G /tmp/ngap.txt core1-ngap.txt
fetch $CN5G /tmp/amf.log core1-amf.log
fetch $CUDU /tmp/gnb.log gnb1.log
fetch $CUDU2 /tmp/gnb.log gnb2.log
fetch $UE1 /tmp/ue-cell.txt ue1-serving-cell.txt
fetch $UE1 /tmp/ping-ho.out ping-ho.out
sed 's/\x1b\[[0-9;]*m//g' "$OUTDIR/gnb1.log" 2> /dev/null | grep -aE "trigger_n2|N2 HO|Handover|neighbour" > "$OUTDIR/gnb1-handover.txt"

step "Stopping both gNBs"
for host in $CUDU $CUDU2; do
    on $host <<'EOF'
tmux send-keys -t gnb C-c 2> /dev/null; sleep 1
sudo pkill -INT -x nr-softmodem; sleep 2; sudo pkill -KILL -x nr-softmodem
tmux kill-session -t gnb 2> /dev/null; true
EOF
done

step "Summary"
echo "gNB 1 HandoverRequired: $(grep -c "HandoverRequired" "$OUTDIR/core1-ngap.txt" 2> /dev/null)"
echo "core 1 rejection:"
grep -iE "cannot find target|ErrorIndication|HandoverPreparationFailure" "$OUTDIR/core1-ngap.txt" "$OUTDIR/core1-amf.log" 2> /dev/null | sed 's/^/    /'
echo "ue1 serving cell after the attempt (expect 999,99 PCI 1):"
sed 's/^/    /' "$OUTDIR/ue1-serving-cell.txt" 2> /dev/null
echo "ping: $(grep "packets transmitted" "$OUTDIR/ping-ho.out" 2> /dev/null || echo "see gnb1.log")"
