#!/bin/bash
# Capture the S1AP traffic between the MME and all eNBs. Run on an EPC node
# (epc/epc2); Ctrl-C to stop. The LTE twin of ngap-capture (which does NGAP).
OUT=${1:-/tmp/s1ap-$(date +%Y%m%d-%H%M%S).pcap}

if [ "$1" == "-h" ]; then
    cat <<EOF2
usage:
    s1ap-capture [<file>]
        capture S1AP (SCTP port 36412) on the core LAN into <file>
        (default /tmp/s1ap-<date>-<time>.pcap) until Ctrl-C
        read it back with: tshark -r <file> -Y s1ap
EOF2
    exit 0
fi

LANIF=$(ip -4 -o addr show | awk '$4 ~ /^192\.168\.1\./{print $2}')
if [ -z "$LANIF" ]; then
    echo "no 192.168.1.x interface; run this on an EPC node"; exit 1
fi

echo "capturing S1AP on $LANIF to $OUT (Ctrl-C to stop)"
exec sudo tcpdump -i $LANIF -U -w $OUT sctp port 36412
