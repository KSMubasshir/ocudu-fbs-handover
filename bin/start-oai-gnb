#!/bin/bash
BUILDDIR=/var/tmp/oai/cmake_targets/ran_build/build
CFGDIR=/var/tmp/etc/oai
TELNET_ADDR=127.0.0.1
CLOCK=""

usage() {
    cat <<EOF2
usage:
    start-oai-gnb -h
        show this help message
    start-oai-gnb [-c internal|external]
        start the OAI gNB of this node in the foreground with the telnet
        server that bin/n2-handover talks to (gNB 1 on cudu, gNB 2 on cudu2;
        picked from the node's 192.168.1.x address). Output is also written
        to /tmp/gnb.log.
        -c  reference clock of the radio; without it the config is left as is
            external: 10 MHz reference in. The time source stays internal on
            both radios: neither gets a PPS, and OAI waits forever for one
            when the time source is external.
EOF2
}

while getopts "hc:" opt; do
    case $opt in
        h) usage; exit 0 ;;
        c) CLOCK=$OPTARG ;;
        *) usage; exit 1 ;;
    esac
done

if [ -n "$CLOCK" ] && [ "$CLOCK" != "internal" ] && [ "$CLOCK" != "external" ]; then
    echo "invalid clock"; usage; exit 1
fi

LANIP=$(ip -4 -o addr show | awk '{print $4}' | grep '^192\.168\.1\.' | cut -d/ -f1)
case $LANIP in
    192.168.1.2)
        NAME="gNB 1 (X310)"
        CFG=$CFGDIR/gnb1_x310_n2_ho.conf
        RUN="numactl --membind 0 --cpubind 0"
        # 184.32 MHz master clock: 3/4 sampling (46.08 Msps), as OAI
        # recommends for the X300 series
        RADIO_ARGS="-E --continuous-tx"
        ;;
    192.168.1.3)
        NAME="gNB 2 (N300)"
        CFG=$CFGDIR/gnb2_n300_n2_ho.conf
        RUN=""
        # 122.88 MHz master clock: full 61.44 Msps, no 3/4 sampling
        RADIO_ARGS=""
        ;;
    *)
        echo "this node is neither cudu (192.168.1.2) nor cudu2 (192.168.1.3)"; exit 1
        ;;
esac

if [ ! -x $BUILDDIR/nr-softmodem ] || [ ! -f $CFG ]; then
    echo "$BUILDDIR/nr-softmodem or $CFG is missing; has the startup script finished?"; exit 1
fi

if pgrep -x nr-softmodem > /dev/null; then
    echo "an nr-softmodem process is already running on this node; stop it first"; exit 1
fi

if [ -n "$CLOCK" ]; then
    sudo sed -i "s/^  clock_src .*/  clock_src      = \"$CLOCK\";/" $CFG
fi

/local/repository/bin/tune-sdr-iface.sh > /dev/null

# The N2 link must not have a larger MTU than the core's interface (1500):
# HandoverRequired is bigger than 1500 bytes and is silently lost as a jumbo
# frame, while every smaller NGAP message still gets through.
LANIF=$(ip -4 -o addr show | awk -v ip="$LANIP" '$4 ~ "^"ip"/" {print $2}')
if [ "$(cat /sys/class/net/$LANIF/mtu)" -gt 1500 ]; then
    echo "setting MTU of $LANIF ($LANIP) to 1500"
    sudo ip link set $LANIF mtu 1500
fi

echo "starting $NAME with $CFG"
grep -n "clock_src\|time_src" $CFG
# nr-softmodem writes nrRRC_stats.log (UE IDs for bin/n2-handover) to its
# working directory
cd $BUILDDIR
sudo $RUN ./nr-softmodem -O $CFG $RADIO_ARGS \
    --gNBs.[0].min_rxtxtime 6 --usrp-tx-thread-config 1 \
    --telnetsrv --telnetsrv.shrmod ci --telnetsrv.listenaddr $TELNET_ADDR \
    2>&1 | sudo tee /tmp/gnb.log
